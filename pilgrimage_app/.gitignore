# ---- OS / 一般ゴミ ----
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# ---- IDE ----
*.iml
*.ipr
*.iws
.idea/
.vscode/            # 共有したくないなら有効化

# ---- Flutter/Dart ----
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/doc/api/
**/ios/Flutter/.last_build_id
/build/

# ---- iOS / CocoaPods ----
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Flutter.podspec
/ios/Flutter/App.framework
/ios/Flutter/Flutter.framework
/ios/Flutter/ephemeral/
**/DerivedData/

# ---- Android ----
/android/.gradle/
.gradle/                   # ルート直下の .gradle も無視
/android/app/debug
/android/app/profile
/android/app/release
/android/local.properties  # ← ここに Maps など入れる
key.properties
*.jks
*.keystore

# ---- シークレット（必ず無視） ----
/serviceAccountKey.json    # ルートのサービスアカウント鍵
/secrets/                  # 鍵置き場を作るなら
.env
.env.*                     # 環境ごとの .env を使う場合

# ---- その他 ----
app.*.symbols
app.*.map.json
